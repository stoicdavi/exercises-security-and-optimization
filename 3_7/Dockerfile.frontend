# use here COPY 1_12 .
FROM node:16-alpine
WORKDIR /src/usr/app

COPY code/example-frontend/package*.json ./
COPY code/example-frontend/ ./

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install \
&& npm run build \
&& npm install -g serve \
&& adduser -D appuser \
&& chown -R appuser:appuser /src/usr/app
    
USER appuser

EXPOSE 5001

CMD ["serve", "-s", "build", "-l", "5001"] 
