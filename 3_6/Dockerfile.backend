# use here COPY 1_13 .
FROM golang:1.27.3-alpine AS builder

WORKDIR /app


COPY code/example-backend/ .

# compile application into a standalone binary
RUN CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o server .


# Creat minimal runtime image
FROM scratch
COPY --from=builder /app/server /server


# application configuration
ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001
ENV REDIS_PORT=6379

USER 1001:1001

EXPOSE 8080

CMD ["./server"]
